# server/.env 示例：复制成 .env 后填真实值（.env 不要提交到仓库）
# 用法：cp .env.example .env

# ===== 必填：模型服务密钥 =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 服务端口 =====
PORT=3000

# ===== 上下文预算（token，近似值）=====
# 按模型上下文窗口的 30%~50% 取。太小会让长对话"失忆"，太大会推高成本。
MAX_CONTEXT_TOKENS=6000

# ===== 模型角色（不填则用默认值，填了才生效）=====
# reasoning：深度思考角色（前端"深度思考"点亮时用它）
# MODEL_REASONING=deepseek-reasoner
# fast：快速角色（关闭深度思考、或对话短问答用它）
# MODEL_FAST=deepseek-chat
# vision：视觉角色（本轮消息带图片时强制用它）
# MODEL_VISION=deepseek-flash
# 备选（实测均可用）：deepseek-flash / deepseek-v4-pro / deepseek-chat / deepseek-reasoner
# 其中 deepseek-chat 不产出思考过程，其余都会先思考再回答。

# ===== 管理员引导（两个变量都给全才会创建/重置 admin 账号）=====
# 启动时若账号不存在则创建；已存在则按这两个值重置密码与角色。
# 生产环境务必改成强密码，并且只在首次部署时保留。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# ===== 成本闸门（P0）=====
# 每用户每日 token 上限；0 = 不限制
DAILY_TOKEN_LIMIT=500000
# 频控：窗口内最多请求数
CHAT_RATE_MAX=30
COMPAT_RATE_MAX=20
RATE_WINDOW_MS=60000

# ===== 备份 =====
# 自动备份间隔（小时）与保留份数
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# BACKUP_DIR=data/backups   # 备份目录（相对 server/）
# BACKUP_DISABLED=1         # 关闭自动备份

# ===== 日志 =====
# LOG_LEVEL=info        # debug / info / warn / error
# LOG_TO_FILE=0         # 关掉文件日志（只输出 stdout）
# LOG_MAX_BYTES=10485760
# LOG_KEEP_DAYS=7

# ===== 其他可调项（一般不用动）=====
# 单轮最多工具调用步数
# MAX_AGENT_STEPS=5
# 检索弱相关阈值：低于它的片段会触发"知识库没找到"的强提醒
# RAG_LOW_SCORE=0.2
# 前端构建产物目录（默认 web/dist）
# WEB_DIST=../web/dist
# 数据库文件（默认 data/app.db）
# APP_DB_FILE=data/app.db

# ===== Webhook（可选）=====
# WEBHOOK_ALLOW_PRIVATE=1  # 允许回调内网地址，仅本地测试用

# ===== MCP（外部工具热插拔，见 server/mcp.json）=====
# 关掉全部 MCP：MCP_ENABLED=0
# 也可以用环境变量直接给配置（适合容器/云上，不落文件）：
# MCP_SERVERS=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
# 自定义配置文件路径（默认 server/mcp.json）
# MCP_CONFIG_FILE=./mcp.json
# 连接/调用超时（毫秒）：外部 server 首次拉包会慢，别设太小
# MCP_CONNECT_TIMEOUT_MS=15000
# MCP_CALL_TIMEOUT_MS=30000

# ===== 会话图片（聊天里发的图）=====
# 签名密钥：不填会自动生成到 data/.image-secret（重启后老图片地址仍有效）
# IMAGE_SIGN_SECRET=please-change-in-production
# 图片存放目录与保留天数
# CHAT_IMAGE_DIR=data/images
# CHAT_IMAGE_TTL_DAYS=30

# ===== P0 生产化（云平台必填，见 RAILWAY-DEPLOY.md）=====
# 所有运行时数据的唯一根目录。Railway 上设 /app/data 并把 Volume 挂到同一路径；
# 本机不设则默认 server/data，行为与旧版一致。
# APP_DATA_DIR=/app/data
# 图片签名密钥：显式设置后卷重建也不会让历史图片 403（openssl rand -hex 32 生成）
# IMAGE_SIGN_SECRET=
# 图片签名链接有效期（天）。0/不设 = 永不过期；设了更安全，但过期的历史图片会失效
# IMAGE_SIGN_TTL_DAYS=0
# 允许跨域的前端来源（逗号分隔）。前后端同源部署不要设，设了才启用 CORS 白名单
# CORS_ORIGINS=
# 后台预热 embedding 模型，避免第一个用户等 1 分钟（云上占内存，按需开）
# WARMUP_EMBEDDING=1
# 优雅关闭最长等待时间（毫秒），等 SSE 流跑完；超时强制退出
# SHUTDOWN_TIMEOUT_MS=20000
# embedding 模型缓存目录（默认 <APP_DATA_DIR>/transformers-cache）
# TRANSFORMERS_CACHE=

# ===== P1 运维告警 =====
# 滑动窗口内 error 数达阈值即告警一次，之后进入冷却期避免刷屏
# OPS_ALERT_THRESHOLD=5
# OPS_ALERT_WINDOW_MS=300000
# OPS_ALERT_COOLDOWN_MS=600000
# 不配 webhook 时只写日志 + ops.alert 审计；配了则 POST JSON（带 HMAC 的 X-Signature）
# OPS_ALERT_WEBHOOK=
# OPS_ALERT_SECRET=
