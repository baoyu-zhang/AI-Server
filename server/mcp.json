[
  {
    "name": "demo",
    "transport": "stdio",
    "command": "node",
    "args": ["mcp-demo-server.js"],
    "enabled": true,
    "requireApproval": "auto"
  },
  {
    "name": "filesystem",
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
    "enabled": false,
    "requireApproval": "auto",
    "allowTools": ["read_file", "list_directory", "directory_tree", "search_files"]
  },
  {
    "name": "remote-example",
    "transport": "http",
    "url": "https://example.com/mcp",
    "headers": { "Authorization": "Bearer <token>" },
    "enabled": false,
    "requireApproval": true
  }
]
