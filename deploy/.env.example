# ============================================================================
# AI-Server 私有化交付 · 环境变量模板
# ============================================================================
# 本文件只是「模板」，只进 git、不含任何真实密钥。
# 请勿直接改名成 .env 使用：请运行 `npm run setup`（或 node scripts/setup.mjs）
# 由向导生成 deploy/.env，它会自动生成强随机密码与图片签名密钥。
# deploy/.env 已被仓库 .gitignore 忽略，且向导会以 0600 权限写入，
# 但它仍是明文密钥文件：不要提交、不要转发、用完请妥善保管。
# ============================================================================

# ===== 必填：模型服务 =====
# DeepSeek 控制台申请的 API Key；留空服务可启动但 AI 聊天不可用（setup 会给中文警告）
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_REAL_KEY

# ===== 必填：初始管理员账号 =====
# 首次启动时由 server/index.js 引导创建；用户名不能为空
ADMIN_USERNAME=admin
# 生产环境 security.js 会拒绝弱口令，必须 ≥12 位随机串；setup 未提供时自动生成 ≥16 位。
# 注意：index.js 把 env 当作唯一事实源，容器每次启动都会把该账号密码重置成这里的值；
# 在管理后台改密码后，请同步更新本文件并重启，否则重启时新密码会被覆盖回去。
ADMIN_PASSWORD=REPLACE_ME_OR_LET_SETUP_GENERATE

# ===== 必填：数据与密钥 =====
# 唯一可写目录，必须与 deploy/docker-compose.yml 的卷挂载 /app/data 完全一致；
# 容器内路径固定为 /app/data，改这里之前先改 compose 的卷挂载，否则数据会写进镜像层而丢失
APP_DATA_DIR=/app/data
# 图片签名密钥，用于生成带签名的图片 URL；卷重建后不改它，历史图片链接才不会全部 403。
# setup 总是自动生成 32 字节（64 位 hex）随机串，无需手工填写。
IMAGE_SIGN_SECRET=REPLACE_ME_OR_LET_SETUP_GENERATE

# ===== 生产基线 =====
# 生产模式：开启 security.js 的强口令 / 密钥自检，同时关闭开发期调试输出
NODE_ENV=production
# 0 = 日志只写 stdout（由 docker 收集），不落盘；避免容器里再叠一层文件 IO 与卷占用
LOG_TO_FILE=0

# ===== 可选：接入外部 MCP 工具 =====
# 交付镜像里 server/mcp.json 默认是空数组（不含任何 demo 工具与假地址）。
# 需要让 Agent 调你们 OA / CRM 的 MCP 服务时，把 deploy/mcp.example.json 的条目改好、
# 压成一行 JSON 填到下面，并去掉行首的 #。镜像层只读，环境变量比改容器内文件可靠，
# 升级镜像也不会丢。配置字段与中文说明见 mcp.example.json、交付清单 3.4 节。
# 另一个选择是 MCP_CONFIG_FILE 指向挂载进容器的配置文件（两者同时给时 MCP_SERVERS 优先）。
# 注：下面这行是注释，初始化向导只替换行首的 KEY=...，不会动它。
# MCP_SERVERS=[]

# ===== 可选：品牌与许可（第二阶段「能签」） =====
# 品牌默认读数据卷里的 branding.json（路径 = APP_DATA_DIR/branding.json），文件不存在
# 就用内置默认品牌，产品照常可用。模板见 deploy/branding.example.json：改产品名、Logo、
# 登录页文案、行业术语、是否显示候选人页签，改完重启容器即生效，**不用重建镜像**。
# 只有想放到非默认位置时才需要显式指定（容器内路径，注意挂载）：
# BRANDING_FILE=/app/data/branding.json
#
# 许可文件默认读 APP_DATA_DIR/license.json，字段模板见 deploy/license.example.json，
# 请用 `npm run license:generate -- --customer '客户名' --seats 30 --expires 2027-11-13` 生成。
# 生成工具的 LICENSE_SIGN_SECRET 必须与这里填的完全一致，否则验签不通过。
# LICENSE_FILE=/app/data/license.json
# LICENSE_SIGN_SECRET=
# 0（默认）= 到期 / 超额 / 签名异常只在登录页提示，不阻断使用；
# 1 = 上述情况拒绝「新登录」，已登录会话不受影响。是否启用由合同口径决定，
#     千万别在还没放许可文件的环境里误开，否则所有人登不进来。
# LICENSE_ENFORCE=0

# ===== 以下由镜像内置，请勿在此覆盖 =====
# PORT=3000 已在 Dockerfile.offline 里设好（离线交付固定单端口）。
# TRANSFORMERS_CACHE=/app/model-cache 也在镜像里设好，指向内置的预下载模型缓存；
# 一旦在这里改成别的路径，会绕开内置缓存、让离线环境启动时重新联网下载几百 MB 而失败。
