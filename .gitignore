# 密钥文件（最重要，防止api key泄露）
.env

# 依赖
node_modules

# 日志
*.log
server/logs/
npm-debug.log*

# 向量库、上传文件缓存（本地 RAG 运行时产物，不进仓库）
# 注意：只写在这里不够。文件一旦被提交过，git 就不再理会 ignore 规则，
# 必须执行 git rm -r --cached uploads vector-index 把它从索引里摘掉（--cached 不删磁盘文件）。
vectra_db/
vector-index/
uploads/

# mac垃圾文件
.DS_Store

dist/

# 候选人状态表（本地运行时数据）
data/

# 每次跑评测都会覆盖的产物，基线文件（baseline*.json）才是要留的
server/eval/results/latest.json

# 本地生成的备份 / 接线说明 / 复盘中间产物（不进 GitHub）
output/
